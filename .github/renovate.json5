{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Amsterdam)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  packageRules: [
    {
      description: "Pin home-operations images to their sha256 digest (upstream recommends digests over tags)",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/**"],
      pinDigests: true,
    },
    {
      description: "Group the one-off digest pinning of home-operations images into a single PR",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/**"],
      matchUpdateTypes: ["pinDigest"],
      groupName: "home-operations image digests",
    },
  ],
}
